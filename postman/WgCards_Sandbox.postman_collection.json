              "pm.test('code === 200', () => pm.expect(decrypted && decrypted.code).to.eql(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "appId", "value": "{{appId}}" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": { "mode": "raw", "raw": "{{requestBody}}", "options": { "raw": { "language": "json" } } },
        "url": { "raw": "{{host}}/api/getAllItem", "host": ["{{host}}"], "path": ["api", "getAllItem"] },
        "description": "Rate limit: 20 requests / 60s. Pulls the full catalog in one call. Requires token from 'Get Token'."
      }
    },
