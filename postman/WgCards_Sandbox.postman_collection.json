      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "appId", "value": "{{appId}}" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": { "mode": "raw", "raw": "{{requestBody}}", "options": { "raw": { "language": "json" } } },
        "url": { "raw": "{{host}}/api/getAccount", "host": ["{{host}}"], "path": ["api", "getAccount"] },
        "description": "Rate limit: 40 requests / 60s. Returns wallet balance(s). Requires token from 'Get Token'."
      }
    },
    {
      "name": "3. Get All Item (catalog)",
      "event": [
