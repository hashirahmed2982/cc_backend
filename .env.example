# Database
DB_HOST=localhost
DB_NAME=cardcove_db
DB_USER=root
DB_PASSWORD=Hash2982

# JWT Secrets (MUST CHANGE IN PRODUCTION)
JWT_SECRET=change-this-to-a-random-32-char-string
JWT_REFRESH_SECRET=change-this-to-another-random-32-char-string

# Session Secret
SESSION_SECRET=change-this-to-random-string

# Encryption
ENCRYPTION_KEY=exactly-32-characters-long-key!

# Email (Gmail Example)
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password

# WgCards API v4 (was called "CarryPin" internally in earlier code — same
# vendor; also migrated off the v3 wire protocol — see wgcards.service.js's
# header for the full v3-vs-v4 difference list). UNLIKE v3, the v4 doc
# publishes NO fixed public sandbox credentials at all — WGCARDS_APP_ID,
# WGCARDS_SECRET, and WGCARDS_BODY_KEY_MATERIAL are all REQUIRED; request a
# v4 test set from WgCards before running seed_wgcards_config.js. Only
# WGCARDS_HOST has a safe default (the v4 doc's test-environment URL is
# public, non-secret info) if left unset.
# IMPORTANT: quote WGCARDS_SECRET. If it can contain '#' the way v3's
# app_key could, dotenv treats that as a start-of-comment on an unquoted
# value and silently truncates everything after it — quoting prevents that.
WGCARDS_HOST=http://120.26.99.152:9071/wgcards-api
WGCARDS_APP_ID=your_wgcards_v4_app_id
WGCARDS_SECRET="your_wgcards_v4_secret"
WGCARDS_BODY_KEY_MATERIAL=your_wgcards_v4_body_key_material

# Flow F (Direct Top-Up) — public URL WgCards POSTs the recharge/order
# result to (v4 doc's "Callbacks" section — this used to be v3's Annex
# III). Must be reachable from the internet, e.g.
# https://api.yourdomain.com/webhooks/wgcards/topup — a localhost/ngrok URL
# only works for sandbox testing.
WGCARDS_TOPUP_WEBHOOK_URL=https://your-public-domain/webhooks/wgcards/topup

# Gift2Games API (Master Plan §1/§9/§10 — Phase 8). Static JWT, no refresh
# endpoint — if it expires/rotates, a human has to get a new one from
# Gift2Games and re-run `npm run seed:gift2games`. No sandbox default
# exists (unlike WGCARDS_*) — both are required for the seed script to run.
GIFT2GAMES_HOST=https://gift2games.net/api
GIFT2GAMES_JWT=your_gift2games_jwt