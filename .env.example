# Database
DB_HOST=localhost
DB_NAME=cardcove_db
DB_USER=root
DB_PASSWORD=Hash2982

# JWT Secrets (MUST CHANGE IN PRODUCTION)
JWT_SECRET=change-this-to-a-random-32-char-string
JWT_REFRESH_SECRET=change-this-to-another-random-32-char-string

# Session Secret
SESSION_SECRET=change-this-to-random-string

# Encryption
ENCRYPTION_KEY=exactly-32-characters-long-key!

# Email (Gmail Example)
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password

# WgCards API (was called "CarryPin" internally in earlier code — same vendor)
# Sandbox defaults (public debug credentials from WgCards_English_API_Doc_V3_0_8)
# are used automatically by seed_wgcards_config.js if these are left unset.
# IMPORTANT: quote WGCARDS_APP_KEY. WgCards app keys can contain '#', which
# dotenv treats as a start-of-comment on an unquoted value and silently
# truncates everything after it — quoting prevents that.
WGCARDS_HOST=http://121.43.36.102:9009
WGCARDS_APP_ID=your_wgcards_app_id
WGCARDS_ACCOUNT_ID=your_wgcards_account_id
WGCARDS_APP_KEY="your_wgcards_app_key"

# Flow F (Direct Top-Up) — public URL WgCards POSTs the recharge result to
# (Annex III). Must be reachable from the internet, e.g.
# https://api.yourdomain.com/webhooks/wgcards/topup — a localhost/ngrok URL
# only works for sandbox testing.
WGCARDS_TOPUP_WEBHOOK_URL=https://your-public-domain/webhooks/wgcards/topup

# Gift2Games API (Master Plan §1/§9/§10 — Phase 8). Static JWT, no refresh
# endpoint — if it expires/rotates, a human has to get a new one from
# Gift2Games and re-run `npm run seed:gift2games`. No sandbox default
# exists (unlike WGCARDS_*) — both are required for the seed script to run.
GIFT2GAMES_HOST=https://gift2games.net/api
GIFT2GAMES_JWT=your_gift2games_jwt